{
  "name": "personal-context",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Portable, evidence-aware personal knowledge runtime for coding agents.",
  "license": "MIT",
  "author": "Jaemani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaemani/PersonalContext.git"
  },
  "homepage": "https://github.com/Jaemani/PersonalContext#readme",
  "bugs": {
    "url": "https://github.com/Jaemani/PersonalContext/issues"
  },
  "keywords": [
    "mcp",
    "obsidian",
    "knowledge-base",
    "codex",
    "claude-code"
  ],
  "files": [
    "dist/runtime",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/KNOWLEDGE_CONTRACT.md",
    "docs/PRODUCT_BOUNDARY.md"
  ],
  "bin": {
    "personal-context": "dist/runtime/personal-context.mjs"
  },
  "scripts": {
    "build": "npm run clean && npm run build:ui && npm run build:ts && npm run bundle:runtime",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:ui": "vite build --config packages/setup-ui/vite.config.ts",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node scripts/clean.mjs",
    "prepare": "npm run build",
    "prepack": "npm run check && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "dev": "vite --config packages/setup-ui/vite.config.ts",
    "dev:cli": "tsx packages/cli/src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
